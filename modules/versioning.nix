{ config, options, pkgs, lib, ... }:

# Every change that breaks functionality from the user's point of view needs an
# entry here (see "Breaking changes" in ../AGENTS.md).
# Let V be the upcoming release.
# 1. Add change descriptions with `version = V` at the end of the `changes` list below.
# 2. Set `nix-bitcoin.configVersion = V` in ../examples/configuration.nix,
#    unless it already is.

with lib;
let
  nbLib = config.nix-bitcoin.lib;
  versioningOptions = {
    nix-bitcoin.configVersion = mkOption {
      type = with types; nullOr str;
      default = null;
      example = "0.0.92";
      description = ''
        The nix-bitcoin release version that your config is compatible with.

        When upgrading to a backwards-incompatible release, nix-bitcoin will throw an
        error during evaluation and provide instructions for migrating your config to
        the new release.

        Once set, you only need to update this option when explicitly told to in an
        error message during evaluation.
      '';
    };
    # Lets tests check each notice
    nix-bitcoin.versioning.incompatibleChanges = mkOption {
      internal = true;
      readOnly = true;
      type = with types; listOf str;
      default = map (change: change.message) incompatibleChanges;
      defaultText = "(See source)";
      description = "Messages of the changes that apply to this config.";
    };
  };

  # Sorted by increasing version numbers
  changes = [
    (mkOnionServiceChange "clightning")
    (mkOnionServiceChange "lnd")
    (mkOnionServiceChange "btcpayserver")
    {
      version = "0.0.41";
      condition = config.services.lnd.enable;
      message = let
        lnd = config.services.lnd;
        seed = escapeShellArg "${config.nix-bitcoin.secretsDir}/lnd-seed-mnemonic";
        dataDir = escapeShellArg lnd.dataDir;
      in ''
        Secret files generated by services at runtime are now stored in the service
        data dirs instead of the global secrets dir.

        To migrate, run the following Bash script as root on your bitcoinix node:

          systemctl stop lnd &&
            if [[ -e ${seed} && ! -e ${escapeShellArg "${lnd.dataDir}/lnd-seed-mnemonic"} ]]; then
              install -o ${escapeShellArg lnd.user} -g ${escapeShellArg lnd.group} -m400 -t ${dataDir} ${seed} &&
                rm ${seed}
            fi
      '';
    }
    {
      version = "0.0.53";
      condition = config.services.electrs.enable;
      message = let
        dbPath = "${config.services.electrs.dataDir}/mainnet";
      in ''
        Electrs 0.9.0 has switched to a new, more space efficient database format,
        reducing storage demands by ~60% [1].
        When started, electrs will automatically reindex the bitcoin blockchain.
        This can take a few hours, depending on your hardware. The electrs server is
        inactive during reindexing.

        To upgrade, do the following:

        - If you have less than 40 GB of free space [2] on the electrs data dir volume:
          1. Delete the database:
             systemctl stop electrs && rm -r ${escapeShellArg dbPath}
          2. Deploy the new system config to your node

        - Otherwise:
          1. Deploy the new system config to your node
          2. Check that electrs works as expected and delete the old database:
             rm -r ${escapeShellArg dbPath}

        [1] https://github.com/romanz/electrs/blob/557911e3baf9a000f883a6f619f0518945a7678d/doc/usage.md#upgrading
        [2] This is based on the bitcoin blockchain size as of 2021-09.
            The general formula is, approximately, size_of(${dbPath}) * 0.6
            This includes the final database size (0.4) plus some extra storage (0.2).
      '';
    }
    {
      version = "0.0.65";
      condition = config.nix-bitcoin ? secure-node-preset-enabled &&
                  config.nix-bitcoin.secretsDir == "/etc/nix-bitcoin-secrets";
      message = ''
        The `secure-node.nix` preset does not set the secrets directory
        to "/secrets" anymore.
        Instead, the default location "/etc/nix-bitcoin-secrets" is used.

        To upgrade, choose one of the following:

        - Continue using "/secrets":
          Add `nix-bitcoin.secretsDir = "/secrets";` to your configuration.nix.

        - Move your secrets to the default location:
          Run the following command as root on your node:
          `rsync -a /secrets/ /etc/nix-bitcoin-secrets`.
          You can delete the old "/secrets" directory after deploying the new system
          config to your node.
      '';
    }
    {
      version = "0.0.70";
      condition = config.services.nbxplorer.enable;
      message = ''
        The nbxplorer database backend has changed from DBTrie to Postgresql.
        The new `services.postgresql` database name is `nbxplorer`.
        The migration happens automatically after deploying.
        Migration time for a large server with a 5GB DBTrie database takes about 40 minutes.
        See also: https://github.com/btcpayserver/NBXplorer/blob/b691999b14eb2a06547ffa708c11574fa323d769/docs/Postgres-Migration.md
      '';
    }
    {
      version = "0.0.70";
      condition = options.services.lnd.lndconnectOnion.isDefined;
      message = ''
        The `lndconnect-rest-onion` binary has been renamed to `lndconnect`.
      '';
    }
    {
      version = "0.0.85";
      condition = config.services.fulcrum.enable;
      message = ''
        Fulcrum 1.9.0 has changed its database format.
        The database update happens automatically and instantly on deployment,
        but you can't switch back to an older Fulcrum version afterwards.
      '';
    }
    {
      version = "0.1.0";
      condition = with config.services;
        (lnd.enable && lnd.lndconnect.enable && !lnd.lndconnect.onion
          && lnd.restAddress == "127.0.0.1")
        || (clightning.plugins.clnrest.enable && clightning.plugins.clnrest.lnconnect.enable
          && !clightning.plugins.clnrest.lnconnect.onion
          && clightning.plugins.clnrest.address == "127.0.0.1");
      message = ''
        Enabling `lndconnect` or `lnconnect` without `onion` no longer sets the REST
        listen address to 0.0.0.0, so the lnd/clnrest REST APIs now listen on localhost only.
        To connect over your LAN or VPN, set the address yourself. See docs/services.md,
        "Connecting without Tor or WireGuard".
      '';
    }
    {
      version = "0.1.1";
      condition = options.services.liquidd.isDefined
        || options.services.btcpayserver.lbtc.isDefined;
      message = ''
        Liquid support, including the Elements daemon, liquid-swap and BTCPay Server's
        LBTC integration, has been removed.

        If you used Liquid, remove `services.liquidd`, `services.btcpayserver.lbtc` and
        any Liquid-specific onion service or network namespace settings from your
        configuration. Your Liquid wallets stay in the former data directory
        (default: /var/lib/liquidd), but the backups service no longer includes it.
        See docs/upgrading.md, "Upgrading to config version 0.1.1", for how to keep
        backing up and later access your wallets.
      '';
    }
    {
      version = "0.1.1";
      condition = config.nix-bitcoin.netns-isolation.enable;
      message = ''
        The `netns-exec` wrapper has been removed. Its namespace allowlist had been empty
        since joinmarket was removed, so it rejected every namespace.
        To run a command in a service namespace, use `sudo ip netns exec nb-<service> <command>`.
        Remove `nix-bitcoin.netns-isolation.allowedUser` from your configuration if you set it.
        '';
    }
    {
      version = "0.1.1";
      condition = options.services.lightning-pool.isDefined;
      message = ''
        Lightning Pool support has been removed. Remove `services.lightning-pool`
        and any Pool-specific onion service or network namespace settings from your
        configuration. Manage Pool separately if needed. Existing data is retained;
        see docs/upgrading.md, "Upgrading to config version 0.1.1".
      '';
    }
    {
      version = "0.1.1";
      condition = options.services.lightning-loop.isDefined
        || options.services.rtl.nodes.lnd.loop.isDefined;
      message = ''
        Lightning Loop support and RTL's Loop integration have been removed.

        Before switching, make sure no Loop swap is in progress (`loop listswaps`);
        a Loop Out whose preimage was already revealed can lose the swap amount
        once `loopd` stops.

        Remove `services.lightning-loop`, `services.rtl.nodes.lnd.loop` and any
        Loop-specific onion service or network namespace settings from your
        configuration. Manage Loop separately if needed. Existing data is retained;
        see docs/upgrading.md, "Upgrading to config version 0.1.1".
      '';
    }
    {
      version = "0.1.1";
      condition = let
        whitelist = config.services.bitcoind.rpc.users.btcpayserver.rpcwhitelist;
      in config.services.btcpayserver.enable
        # An empty list disables the whitelist for this user.
        && whitelist != [] && !(elem "scantxoutset" whitelist);
      message = ''
        BTCPay Server's wallet UTXO scan is now disabled by default. The
        `btcpayserver` RPC user no longer has permission to call `scantxoutset`,
        because a scan can keep bitcoind busy for minutes.

        To keep using this feature, add:
          services.bitcoind.rpc.users.btcpayserver.rpcwhitelist = [ "scantxoutset" ];

        Otherwise, leave it disabled and acknowledge the change by updating
        `nix-bitcoin.configVersion`. See docs/upgrading.md,
        "Upgrading to config version 0.1.1".
      '';
    }
    {
      version = "0.1.1";
      condition = config.services.charge-lnd.enable;
      message = ''
        The charge-lnd macaroon no longer grants broad offchain write access.
        It only allows reads and the UpdateChannelPolicy and UpdateChanStatus RPCs.
        Other applications that reused this macaroon need their own macaroon with
        the appropriate permissions. lnd regenerates /run/lnd/charge-lnd.macaroon
        when it restarts during deployment. See docs/upgrading.md,
        "Upgrading to config version 0.1.1".
      '';
    }
    {
      version = "0.1.1";
      condition = clightningRestUsed;
      message = ''
        c-lightning-REST is no longer maintained and has been removed.
        Remove `services.clightning-rest`, the legacy `services.rtl.cl-rest` option,
        and any associated onion service or network namespace settings from your
        configuration. Use `services.clightning.plugins.clnrest` instead.
        Replace `lndconnect-clightning` and `lndconnect-clightning-wg` with
        `lnconnect-clnrest` and `lnconnect-clnrest-wg` and reconnect your clients.
        Custom clients must adapt to clnrest's API. clnrest shares Core Lightning's
        service sandbox, network namespace and Tor-enforcement settings.

        Existing data is retained, but the backups service no longer includes the
        former data directory (default: /var/lib/clightning-rest).
        See docs/upgrading.md, "Upgrading to config version 0.1.1", for migration
        and backup instructions.
      '';
    }
    {
      version = "0.1.1";
      condition = !clightningRestUsed
        && config.services.backups.enable && config.services.clightning.enable;
      message = ''
        c-lightning-REST has been removed. If you previously ran it, the backups service
        no longer includes its data directory (default: /var/lib/clightning-rest).
        See docs/upgrading.md, "Upgrading to config version 0.1.1".
      '';
    }
    {
      version = "0.1.2";
      condition = config.services.bitcoind.enable;
      message = let
        bitcoind = config.services.bitcoind;
      in ''
        bitcoind's RPC authentication cookie has moved from
        `${bitcoind.dataDir}/${optionalString (bitcoind.network == "regtest") "regtest/"}.cookie`
        to `/run/bitcoind/.cookie`.

        Update external RPC clients and scripts that read the old cookie path.
        The bitcoin-cli installed by bitcoinix reads the new path from bitcoin.conf.
        See docs/upgrading.md, "Upgrading to config version 0.1.2".
      '';
    }
    {
      version = "0.1.2";
      condition = config.services.mempool.enable;
      message = ''
        The mempool backend now listens on `services.mempool.address` (default 127.0.0.1)
        instead of on all interfaces. The nginx frontend is unaffected. To reach the
        backend API from other hosts directly, set `services.mempool.address`.
        The MariaDB server that mempool enables now listens on 127.0.0.1 by default
        (`services.mysql.settings.mysqld.bind-address`). To keep accessing MariaDB
        over the network, set this option to the desired listen address.
        See docs/upgrading.md, "Upgrading to config version 0.1.2".
      '';
    }
    {
      version = "0.1.2";
      condition = config.services.lnd.enable;
      message = ''
        lnd now restarts automatically after a clean exit, including `lncli stop`.
        To keep lnd stopped, use `systemctl stop lnd` instead. Update maintenance
        scripts that rely on `lncli stop` leaving lnd down.
        See docs/upgrading.md, "Upgrading to config version 0.1.2".
      '';
    }
    {
      version = "0.1.2";
      condition = config.services.btcpayserver.enable;
      message = ''
        BTCPay Server 2.4.5 blocks webhooks, invoice notification URLs and LNURL
        requests to private network addresses (localhost, LAN, VPN) by default.
        The Lightning node configured by bitcoinix is unaffected. To allow private
        destinations, set
        `systemd.services.btcpayserver.environment.BTCPAY_SSRFEXCEPTIONS`,
        e.g. to "192.168.1.50:8443;10.8.0.0/24". Keep exceptions narrow and never
        list the ports of node services such as the lnd REST API.
        See docs/upgrading.md, "Upgrading to config version 0.1.2".
      '';
    }
    {
      version = "0.1.3";
      condition = options.services.bitcoind.package.isDefined;
      message = ''
        Bitcoin Knots support and `services.bitcoind.package` have been removed.
        Remove `services.bitcoind.package` from your configuration. The daemon,
        bitcoin-cli and Core Lightning now use `nix-bitcoin.pkgs.bitcoind`
        (Bitcoin Core) directly.

        If you used Knots, review any Knots-specific settings in
        `services.bitcoind.extraConfig` before deploying.
        See docs/upgrading.md, "Upgrading to config version 0.1.3".
      '';
    }
    {
      version = "0.1.3";
      condition = config.services.electrs.enable;
      message = let
        dbPath = "${config.services.electrs.dataDir}/${nbLib.networkName { mainnet = "bitcoin"; }}";
      in ''
        electrs 0.12.0 uses a new index format and must rebuild its index from scratch.
        It does not convert or delete the old index: until it is removed, electrs
        refuses to start.
        Reindexing takes from a few hours to about a day, depending on your hardware.
        electrs accepts connections while it indexes but answers with incomplete history
        and balances until indexing has finished. The same applies to mempool if it
        uses electrs.

        To upgrade, delete the old index before deploying:
          systemctl stop electrs && rm -r ${escapeShellArg dbPath}
        Then deploy the new system config to your node.
        If you roll back to the previous config after electrs 0.12 has started once,
        also remove the marker file ${escapeShellArg "${dbPath}.bindex"}. Otherwise the index check is
        skipped on the next upgrade.

        electrs now requires Bitcoin Core 31 or later and reads blocks through
        bitcoind's REST interface, which is enabled automatically
        (`services.bitcoind.rest.enable`). REST is served without
        authentication on the RPC port to every source in `services.bitcoind.rpc.allowip`.
        If that list contains sources other than localhost and bitcoinix's network
        namespaces, evaluation fails. Remove them, or set
        `services.bitcoind.rest.allowNonLocal = true` only if these sources may read
        blocks, transactions, the UTXO set and the mempool without authentication.
        `rpcallowip` or `includeconf` in `services.bitcoind.extraConfig` also fail
        evaluation (see `services.bitcoind.rest.allowUncheckedConfig`).
        See docs/upgrading.md, "Upgrading to config version 0.1.3".
      '';
    }
    {
      version = "0.1.3";
      # Custom hooks and plugins cannot be inspected at evaluation time, so
      # notify users of all services that receive the new restriction.
      condition = with config.services;
        any (service: service.enable) [
          bitcoind btcpayserver charge-lnd clightning electrs fulcrum
          lnd mempool nbxplorer rtl
        ]
        || config.nix-bitcoin.onionAddresses.access != {}
        || config.nix-bitcoin.onionAddresses.services != [];
      message = ''
        Services using `nix-bitcoin.lib.defaultHardening` now see /run and /dev
        (including /dev/shm) as read-only outside their allowed writable paths.
        Custom service hooks and plugins that write there can fail with
        "Read-only file system".

        Before deploying, check custom hooks and plugins. Use the service's
        runtime or data directory, or add a narrow `ReadWritePaths` exception
        for an existing path that must remain writable.
        See docs/upgrading.md, "Upgrading to config version 0.1.3".
      '';
    }
    {
      version = "0.1.3";
      condition = config.services.mempool.enable;
      message = ''
        mempool 3.3 migrates its database to a new schema on first start. The migration
        can't be undone, and rolling back the NixOS generation keeps the migrated
        database, which mempool 3.2 can't use. To keep a way back, dump the database
        (`${config.services.mempool.database.name}`) before deploying.
        See docs/upgrading.md, "Upgrading to config version 0.1.3".
      '';
    }
    {
      version = "0.1.3";
      # Secret symlinks and custom generation commands cannot be inspected at
      # evaluation time, so notify everyone using the affected setup service.
      condition = config.nix-bitcoin.setupSecrets;
      message = ''
        setup-secrets now runs in a sandbox with no IP network access and only
        the secrets directory and private temporary directories writable.
        Before deploying, replace declared secret symlinks to external files
        with files in `nix-bitcoin.secretsDir`, and adapt custom
        `nix-bitcoin.generateSecretsCmds` to the sandbox or supply secrets before
        setup-secrets starts.

        A failed setup now leaves the entire secrets directory accessible only
        to root even when `nix-bitcoin.generateSecrets` is false. Repair the
        missing or invalid secret and rerun setup to restore service access.
        See docs/upgrading.md, "Upgrading to config version 0.1.3".
      '';
    }
    {
      version = "0.1.5";
      condition = config.services.clightning.plugins.currencyrate.enable;
      message = ''
        The Python currencyrate plugin has been replaced by Core Lightning's Rust
        cln-currencyrate plugin. Keep `services.clightning.plugins.currencyrate.enable`,
        but replace `currencyrates` with `listcurrencyrates` (fiat per BTC rather
        than msat per fiat unit). `currencyconvert` now returns a numeric `msat`.
        Rename `add-source` and `disable-source` to `currencyrate-add-source` and
        `currencyrate-disable-source`. The plugin now follows CLN's configured proxy.
        See docs/upgrading.md, "Upgrading to config version 0.1.5".
      '';
    }
    {
      version = "0.1.5";
      condition = config.services.clightning.plugins.rebalance.enable;
      message = ''
        The rebalance plugin now uses Core Lightning's askrene routing.
        Remove the `getroute_method` argument from `rebalance` RPC calls and
        remove `rebalance-getroute`, `rebalance-maxhops` and `rebalance-msatfactor`
        from your configuration; these settings are now ignored.
        The `rebalancereport` fields `getroute_method`, `maxhops_threshold` and
        `msatfactor` have been removed. Update scripts that read these fields.
        See docs/upgrading.md, "Upgrading to config version 0.1.5".
      '';
    }
    {
      version = "0.1.5";
      condition = config.services.mempool.enable
        && config.services.mempool.settings.CORE_RPC.PASSWORD or null != null;
      message = ''
        `services.mempool.settings.CORE_RPC.PASSWORD` is no longer accepted, because
        mempool's settings are copied to the world-readable Nix store. Remove it and
        save the password to `${config.nix-bitcoin.secretsDir}/bitcoin-rpcpassword-public`.
        See docs/upgrading.md, "Upgrading to config version 0.1.5".
      '';
    }
    {
      version = "0.1.6";
      # Before 0.1.6, lnconnect-clnrest granted the operator clnrest onion access
      # even with the operator role disabled. Only configs that don't grant the
      # access themselves are affected. The operator account may come from outside
      # `users.users` (useradd, LDAP), so don't require it to be defined there.
      # The operator's lnd-rest access isn't checked here: lndconnect reads the
      # lnd user's copy, and the only reader of the operator's copy is nodeinfo,
      # which enables the operator role itself.
      condition = let
        operator = config.nix-bitcoin.operator;
        clnrest = config.services.clightning.plugins.clnrest;
        access = config.nix-bitcoin.onionAddresses.access.${operator.name} or [];
      in !operator.enable
         && clnrest.enable && clnrest.lnconnect.enable && clnrest.lnconnect.onion
         && !(elem "clnrest" access);
      message = let
        name = config.nix-bitcoin.operator.name;
        # The attribute that defines the account, which can differ from its name.
        # Prefer an enabled declaration, then a disabled one.
        accountKeys = filter (key: config.users.users.${key}.name == name)
          (attrNames config.users.users);
        account = findFirst (key: config.users.users.${key}.enable or true)
          (if accountKeys == [] then name else head accountKeys) accountKeys;
      in ''
        lnconnect-clnrest now gives the operator user access to the clnrest onion
        address only when `nix-bitcoin.operator.enable` is set. The operator role is
        disabled, so the operator user `${name}` doesn't get this access.
        To keep it, add "clnrest" to `nix-bitcoin.onionAddresses.access.${name}`,
        which needs `${name}` to be an enabled account in `users.users`. Or set
        `nix-bitcoin.operator.enable = true`, but only if the account is declared as
        an enabled `users.users.${name}` or doesn't exist yet, since the role
        declares it as a normal user. To run `lnconnect-clnrest` as
        `${name}` instead of root, also add "${config.services.clightning.group}" to
        `users.users.${account}.extraGroups`. That group can read the admin rune and use
        the clightning RPC socket.
        See docs/upgrading.md, "Upgrading to config version 0.1.6".
      '';
    }
    {
      version = "0.1.6";
      # Before 0.1.6, access could name users provisioned outside `users.users`
      # (useradd, LDAP/NSS) or disabled there. Compare login names as
      # onion-addresses.nix does. Both onion access entries can fire, even for the
      # same user, and then both apply.
      condition = missingOnionAccessUsers != [];
      message = ''
        `nix-bitcoin.onionAddresses.access` now accepts only users that are defined
        and enabled in `users.users`. These users aren't:
        ${concatStringsSep ", " missingOnionAccessUsers}
        Before, the onion-addresses service looked the names up at runtime, and a name
        that didn't resolve made it publish no onion address for anyone. Now evaluation
        checks them instead.
        To keep a user's access, define and enable the account in `users.users`. For an
        account created with useradd, declare its current uid, group, home and shell,
        since NixOS applies its defaults otherwise. Or remove the user from
        `nix-bitcoin.onionAddresses.access`.
        See docs/upgrading.md, "Upgrading to config version 0.1.6".
      '';
    }
    {
      version = "0.1.6";
      # Secret files can't be inspected at evaluation time, so notify everyone
      # using the affected setup service or lnd.
      condition = config.nix-bitcoin.setupSecrets || config.services.lnd.enable;
      message = ''
        setup-secrets now fails when a declared secret file is empty or isn't a
        regular file, as it does when one is missing. Before deploying, fill any
        empty secret file. For a secret that may be empty, set
        `nix-bitcoin.secrets.<name>.allowEmpty = true`.
        Secret generation doesn't replace an empty TLS, WireGuard or replication
        SSH private key, or a symlink to a missing file in its place: setup fails
        and says how to restore or replace it.
        With the bitcoind-remote preset and `nix-bitcoin.generateSecrets = false`,
        this includes the unused local `bitcoin-HMAC-*` files.
        lnd now stops when wallet.db isn't a regular file, for example a symlink
        to a missing file. While lnd has no wallet.db, it also stops when its seed
        file is a symlink to a missing file.
        See docs/upgrading.md, "Upgrading to config version 0.1.6".
      '';
    }
    {
      version = "0.1.6";
      condition = config.services.lnd.enable;
      message = ''
        Each custom lnd macaroon (`services.lnd.macaroons`, also used by BTCPay Server
        and charge-lnd) now has its own root key, with an ID from 7953919891889717248
        to 7954201366866427903 (0x6e62000000000000 to 0x6e62ffffffffffff). Each time
        lnd starts, bitcoinix deletes the root key of every ID in this range that no
        configured macaroon uses. Before deploying, check that `lncli listmacaroonids`
        lists no ID in this range. Copies of custom macaroons created before this
        change use root key 0 and stay valid. Each lnd start now uses the admin
        macaroon over gRPC, also without custom macaroons, so `no-macaroons` isn't
        supported.
        See docs/upgrading.md, "Upgrading to config version 0.1.6".
      '';
    }
    {
      version = "0.1.6";
      condition = config.services.rtl.enable;
      message = ''
        RTL is now bound to the units of its enabled backends (lnd,
        clightning). It stops when one of them stops, crashes or exits, and a
        backend's start starts it again once all of its backends run. With
        both backends enabled, stopping one of them also stops RTL for the
        other one, and starting RTL starts a stopped backend too. Deploying
        this change restarts each backend that RTL uses once.
        See docs/upgrading.md, "Upgrading to config version 0.1.6".
      '';
    }
    {
      version = "0.1.6";
      condition = config.services.rtl.enable;
      message = ''
        RTL now keeps the two-factor authentication that you set up in its web
        interface across restarts. Before, each restart turned it off. To turn it
        off without the authenticator, delete RTL-Config.json in RTL's data dir and
        restart RTL. RTL-Config.json, which holds the 2FA secret, is now readable
        only by RTL's user, not by group rtl.
        See docs/upgrading.md, "Upgrading to config version 0.1.6".
      '';
    }
    {
      version = "0.2.0";
      condition = options.services.bitcoind.regtest.isDefined
        || options.services.bitcoind.makeNetworkName.isDefined;
      message = ''
        services.bitcoind.regtest has been replaced by the
        services.bitcoind.network option. Replace true with services.bitcoind.network = "regtest";
        or remove the old option for mainnet (the default).
        The makeNetworkName helper has also been removed. Use
        nbLib.networkName { mainnet = "bitcoin"; } instead
        to override mainnet's name while passing other network names through unchanged.
        See docs/upgrading.md, "Upgrading to config version 0.2.0".
      '';
    }
    {
      version = "0.2.0";
      condition = config.services.mempool.enable && config.services.bitcoind.network == "regtest";
      message = ''
        Mempool now uses regtest in both its backend and frontend when
        services.bitcoind.network is "regtest", instead of identifying as mainnet.
        Mempool automatically clears disk caches labelled mainnet and reloads
        data from the configured backend. Review any custom frontend network
        settings or staticContentRoot, then reload the web interface.
        See docs/upgrading.md, "Upgrading to config version 0.2.0".
      '';
    }
    {
      version = "0.2.0";
      condition = config.services.charge-lnd.enable && any
        (flag: flag == "--lnddir" || hasPrefix "--lnddir=" flag)
        config.services.charge-lnd.extraFlags;
      message = ''
        charge-lnd now receives explicit --tlscert and --macaroon paths.
        If you use --lnddir in services.charge-lnd.extraFlags to select custom
        credentials, replace it with --tlscert and --macaroon: --lnddir no
        longer determines the credential paths.
        See docs/upgrading.md, "Upgrading to config version 0.2.0".
      '';
    }
  ];

  missingOnionAccessUsers = let
    userNames = map (u: u.name) (filter (u: u.enable or true) (attrValues config.users.users));
  in filter (user: !(elem user userNames)) (attrNames config.nix-bitcoin.onionAddresses.access);

  clightningRestUsed = options.services.clightning-rest.isDefined
    || options.services.rtl.cl-rest.isDefined;

  mkOnionServiceChange = service: {
    version = "0.0.30";
    condition = config.services.${service}.enable;
    message = ''
        The onion service for ${service} has been disabled in the default
        configuration (`secure-node.nix`).

        To enable the onion service, add the following to your configuration:
        nix-bitcon.onionServices.${service}.enable = true;
      '';
  };

  version = config.nix-bitcoin.configVersion;

  incompatibleChanges = optionals
    (version != null && versionOlder lastChange)
    (builtins.filter (change: versionOlder change && (change.condition or true)) changes);

  errorMsg = ''

    This version of nix-bitcoin contains the following changes
    that are incompatible with your config (version ${version}):

    ${concatMapStringsSep "\n" (change: ''
      - ${change.message}(This change was introduced in version ${change.version})
    '') incompatibleChanges}
    After addressing the above changes, set nix-bitcoin.configVersion = "${lastChange.version}";
    in your nix-bitcoin configuration.
  '';

  versionOlder = change: (builtins.compareVersions change.version version) > 0;
  lastChange = builtins.elemAt changes (builtins.length changes - 1);
in
{
  imports = [
    ./obsolete-options.nix
  ];

  options = versioningOptions;

  config = {
    # Force evaluation. An actual option value is never assigned
    system = optionalAttrs (builtins.length incompatibleChanges > 0) (builtins.throw errorMsg);
  };
}
