 # THROTTLE_LIMIT=20
+# Writable directory for the database, encryption key, runtime config, and temporary files
 # DATABASE_DIR=data
+# Read-only application directory containing dist/client/browser and proto (defaults to the working directory)
+# ASSETS_DIR=/path/to/orchard
 
 # --------------------------------------------
 # Orchard Configs (optional)
