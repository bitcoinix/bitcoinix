--- a/pkgs/populate/default.nix
+++ b/pkgs/populate/default.nix
@@ -1602,7 +1602,7 @@
     exec ${openssh}/bin/ssh \
         ${concatMapStringsSep " " quote (mkUserPortSSHOpts target)} \
         -o ControlMaster=auto \
-        -o ControlPath="$TMPDIR"/ssh-%r@%h:%p.sock \
+        -o ControlPath="$POPULATE_SSH_DIR"/%C \
         -o ControlPersist=1h \
         -T \
         ${concatMapStringsSep " " quote target.extraOptions} \
@@ -1621,14 +1621,21 @@
   TMPDIR=$(${coreutils}/bin/mktemp -dt populate.XXXXXXXX)
   readonly TMPDIR # Ensure the trap will delete the correct thing.
   export TMPDIR # Share it with the jobs and the ssh wrapper.
+  # Keep the ssh control socket in a short private directory in /tmp, as a
+  # socket path in $TMPDIR can exceed the 104-108 bytes allowed for it.
+  # Sources keep using $TMPDIR, where pass and passage decrypt secrets.
+  POPULATE_SSH_DIR=$(${coreutils}/bin/mktemp -d /tmp/populate-ssh.XXXXXXXX) ||
+    { ${coreutils}/bin/rm -R "$TMPDIR"; exit 1; }
+  readonly POPULATE_SSH_DIR
+  export POPULATE_SSH_DIR
   # Stops the ssh master, if any source started one, also after failures,
-  # before its control socket goes away with $TMPDIR.
+  # before its control socket goes away with $POPULATE_SSH_DIR.
   stop_ssh_master() {
     if ${ssh' target} -q -O check ${quote target.host} 2>/dev/null; then
       ${ssh' target} -q -O stop ${quote target.host}
     fi
   }
-  trap 'trap "" HUP INT TERM; stop_ssh_master; rm -R "$TMPDIR"' EXIT
+  trap 'trap "" HUP INT TERM; stop_ssh_master; rm -R "$TMPDIR" "$POPULATE_SSH_DIR"' EXIT
